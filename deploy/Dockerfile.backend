# ────────────────────────────────────────────────────────────────
# price-agent 后端镜像（FastAPI Web / arq worker / reaper 三个进程共用）
# 构建上下文 = 仓库根目录（docker compose 中已设 context: ..）
#
# 用 python:3.10-slim（项目开发环境为 conda fast，Python 3.10.20）
# ────────────────────────────────────────────────────────────────
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# 不装 curl：健康检查用 Python 标准库 urllib 实现（compose 的 healthcheck 已改），
# 避免构建时 apt 访问 Debian 官方源（海外）在国内服务器上超时失败
WORKDIR /app

# 先拷依赖清单并安装 —— 依赖层可被 Docker 缓存复用，改业务代码不用重装
COPY requirements.txt .
# 国内服务器加速：默认走阿里云 PyPI 镜像（海外构建可用 --build-arg PIP_INDEX_URL=... 覆盖）
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RUN pip install --no-cache-dir -r requirements.txt -i "$PIP_INDEX_URL" --trusted-host mirrors.aliyun.com

# 再拷业务代码（顺序：常用/少变的在前，缓存命中率更高）
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .
COPY static ./static
COPY scripts ./scripts

# 上传目录：运行时挂载命名卷（compose 的 uploads_data），此处建目录兜底
RUN mkdir -p /app/uploads

EXPOSE 8000

# 默认启动（compose 的 backend 会用 alembic upgrade head + uvicorn 覆盖此命令）
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
