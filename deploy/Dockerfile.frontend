# ────────────────────────────────────────────────────────────────
# price-agent 前端镜像（Node 20 构建 → nginx 托管静态产物）
# 构建上下文 = 仓库根目录（docker compose 中已设 context: ..）
#
# 注意：Vite base 固定为 /price-agent/（与 vite.config.js 一致），
# 前端路由、资源、API 同源调用都按这个前缀设计，生产 nginx 配置见 deploy/nginx.conf
# ────────────────────────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app

# 2C2G 服务器上构建防 OOM：限制 Node 堆上限（本项目构建实际用量 < 1GB）
ENV NODE_OPTIONS="--max-old-space-size=1536"

# 先装依赖再拷源码：npm ci 用锁文件精确安装并禁用缓存（规避 EINTEGRITY，与 GitHub Actions 一致）
# 国内服务器加速：默认走 npmmirror（淘宝）镜像（海外构建可用 --build-arg NPM_REGISTRY=... 覆盖）
ARG NPM_REGISTRY=https://registry.npmmirror.com
COPY frontend-web/package.json frontend-web/package-lock.json ./
RUN npm ci --registry="$NPM_REGISTRY"

COPY frontend-web/ ./
RUN npm run build

# ── 运行阶段：nginx ──
FROM nginx:1.27-alpine

# 构建产物挂到 nginx 站点根；SPA 前缀逻辑在 deploy/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
