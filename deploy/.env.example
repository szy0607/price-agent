# ════════════════════════════════════════════════════════════════
# price-agent 生产环境密钥（模板）
# 用法：cp .env.example .env  然后逐项改成真实值
#
# ⚠️ 本文件（deploy/.env）已在 .gitignore 中，不会进 Git；但请勿外发
# ⚠️ docker compose 会自动读取本目录的 .env 做变量替换，
#     同时通过 env_file 注入容器 —— 缺了必填项 compose 启动时直接报错
# ════════════════════════════════════════════════════════════════

# ── MySQL（必填）──
# 后端专用账号 price_app 的密码（root 密码只在容器内管理用，应用不连 root）
MYSQL_ROOT_PASSWORD=改成强随机密码
MYSQL_APP_PASSWORD=改成强随机密码

# ── PostgreSQL（必填）──
PG_PASSWORD=改成强随机密码

# ── Redis（必填，服务器公网可及，必须有密码）──
REDIS_PASSWORD=改成强随机密码

# ── 后端密钥（必填）──
# 图形验证码签名密钥：python -c "import secrets; print(secrets.token_urlsafe(32))"
CAPTCHA_KEY=复用本地 .env 的 CAPTCHA_KEY

# 博查 Web Search API Key（付费 key，复用本地 .env 的 BOCHA_API_KEY）
BOCHA_API_KEY=复用本地 .env 的 BOCHA_API_KEY

# 用户 API Key 加密主密钥（AES-256-GCM，32 字节 base64；复用本地 .env 的 API_KEY_KEK。
# ⚠️ 丢失 = 库里所有已配 key 无法解密；如果服务器上不要旧数据，可重新生成）
API_KEY_KEK=复用本地 .env 的 API_KEY_KEK

# 密码长度口径（必须与本地开发保持一致，否则同一密码一边过一边被拒）
PW_MIN_LENGTH=6
PW_MAX_LENGTH=18

# ── 演示账号模型 key（可选，比赛开箱即用）──
# 配齐后执行 seed_demo.py 会给 demo@example.com / demo2@example.com 自动写入默认 key，
# 评委登录即可直接聊天 / RAG 检索，无需进设置页配置。不配则跳过（部署后手动配）。
# 四个变量必须【全部】填写才生效，缺任一都会整组跳过。
# DEMO_MODEL_PROVIDER=deepseek
# DEMO_MODEL_BASE_URL=https://api.deepseek.com
# DEMO_MODEL_NAME=deepseek-chat
# DEMO_MODEL_KEY=本地正在使用的对话模型 key

# 向量模型（RAG 语义检索用，可选；同样是全填才生效）
# DEMO_EMBEDDING_PROVIDER=
# DEMO_EMBEDDING_BASE_URL=
# DEMO_EMBEDDING_NAME=
# DEMO_EMBEDDING_KEY=本地正在使用的向量模型 key

# ── HTTPS（可选）──
# 配好证书后：放开 nginx 的 443 端口，并把这里改成 true（Cookie 加 Secure 标记）
COOKIE_SECURE=false
